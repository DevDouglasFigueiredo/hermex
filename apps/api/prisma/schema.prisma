generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// CHECK de diária positiva e normalização de placa são mantidos na migration SQL.

model Vehicle {
  id           String   @id @default(cuid())
  brand        String
  model        String
  year         Int
  licensePlate String   @unique
  dailyRate    Decimal  @db.Decimal(10, 2)
  available    Boolean  @default(true)
  imageUrl     String?
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  transmission String
}

model Category {
  vehicles  Vehicle[]
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// A migration SQL garante exatamente dois caracteres em state.
model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String
  city      String
  state     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
